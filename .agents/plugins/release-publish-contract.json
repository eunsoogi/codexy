{
  "schema": "codexy.internal.release-publish-contract.v2",
  "name": "codexy",
  "version": "1.5.0",
  "bootstrap": {
    "selectedVersion": "1.5.0",
    "candidateVersion": "1.5.1",
    "publicationWorkflow": ".github/workflows/bootstrap-package.yml"
  },
  "runtime": {
    "selectedTag": "v1.2.2",
    "stagingWorkflow": ".github/workflows/runtime-candidate.yml",
    "activationWorkflow": ".github/workflows/runtime-activation.yml",
    "finalPublisherWorkflow": ".github/workflows/publish-version-release.yml",
    "artifactRetentionDays": 14,
    "platforms": [
      "darwin-arm64",
      "linux-x86_64",
      "windows-x86_64"
    ]
  },
  "currentMarketplace": {
    "repository": "https://github.com/eunsoogi/codexy",
    "ref": "v1.5.0",
    "marketplacePath": ".agents/plugins/marketplace.json",
    "pluginPath": "./plugins/codexy",
    "installCommand": "codex plugin marketplace add eunsoogi/codexy --ref v1.5.0"
  },
  "package": {
    "workflow": ".github/workflows/plugin-runtime-binaries.yml",
    "archive": "dist/codexy-marketplace-plugin.tar.gz",
    "futureInstallRef": "version-tags",
    "platforms": [
      "darwin-arm64",
      "linux-x86_64",
      "windows-x86_64"
    ]
  },
  "sourceMarketplace": {
    "path": ".agents/plugins/marketplace.json",
    "mode": "source-checkout-dev",
    "platforms": [
      "darwin-arm64",
      "linux-x86_64"
    ]
  },
  "releaseArchive": {
    "bundle": "dist/codexy-marketplace-bundle.tar.gz",
    "componentManifest": "packages/getcodexy/src/codexy_runtime_tools/component-manifest.json",
    "platforms": [
      "darwin-arm64",
      "linux-x86_64",
      "windows-x86_64"
    ]
  }
}
