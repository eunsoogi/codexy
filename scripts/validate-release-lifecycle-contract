#!/bin/sh
# shellcheck disable=SC2016,SC2086
set -eu

target_version="${1:?target version is required}"
case "$target_version" in
  *[!0-9.]*|*.*.*.*|.*|*.)
    printf '%s\n' 'target version must be MAJOR.MINOR.PATCH' >&2
    exit 1
    ;;
esac
IFS=.
set -- $target_version
unset IFS
test "$#" = 3 && test -n "$1" && test -n "$2" && test -n "$3" || {
  printf '%s\n' 'target version must be MAJOR.MINOR.PATCH' >&2
  exit 1
}
for component in "$@"; do
  case "$component" in
    0|[1-9]|[1-9][0-9]*) ;;
    *)
      printf '%s\n' 'target version must be MAJOR.MINOR.PATCH' >&2
      exit 1
      ;;
  esac
  length=${#component}
  if test "$length" -gt 10 || { test "$length" -eq 10 && test "$component" -gt 2147483647; }; then
    printf '%s\n' 'target version must be MAJOR.MINOR.PATCH' >&2
    exit 1
  fi
done

# Validate the canonical version bound before comparing every selected package and release contract.
release_tag="v$target_version"
contract=.agents/plugins/release-publish-contract.json
test "$(jq -r .version "$contract")" = "$target_version"
test "$(jq -r .bootstrap.selectedVersion "$contract")" = "$target_version"
test "$(jq -r .bootstrap.candidateVersion "$contract")" = "$target_version"
test "$(jq -r .runtime.selectedTag "$contract")" = "$release_tag"
for manifest in plugins/codexy/.codex-plugin/plugin.json \
  plugins/codexy-devtools/.codex-plugin/plugin.json \
  plugins/codexy-github/.codex-plugin/plugin.json; do
  test "$(jq -r .version "$manifest")" = "$target_version"
done
lock_version="$(python3 -c 'import tomllib; print(next(package["version"] for package in tomllib.load(open("packages/getcodexy/uv.lock", "rb"))["package"] if package["name"] == "getcodexy"))')"
test "$lock_version" = "$target_version"
package_version="$(python3 -c 'import tomllib; print(tomllib.load(open("packages/getcodexy/pyproject.toml", "rb"))["project"]["version"])')"
test "$package_version" = "$lock_version"
component_manifest=packages/getcodexy/src/codexy_runtime_tools/component-manifest.json
jq -e --arg version "$target_version" '
  .schema == "getcodexy.component-manifest.v1" and
  (.components | length == 3) and
  (.compatibleCombinations | length > 0) and
  ([.components[].version] | all(. == $version)) and
  ([.compatibleCombinations[].version] | all(. == $version))
' "$component_manifest" >/dev/null

workflow=.github/workflows/python-package.yml
workflow_helper=scripts/verify_public_marketplace_bundle.py
workflow_support=scripts/public_marketplace_bundle_support.py
baseline_script=.github/scripts/verify-public-marketplace-baselines.ps1
# The Windows lifecycle must use the verifier wrapper and retain its selected-baseline inputs.
for required in \
  '.github/scripts/verify-public-marketplace-baselines.ps1' \
  'BASE_SHA' \
  'PRIOR_PUBLIC_VERSION'; do
  grep -F -- "$required" "$workflow" >/dev/null || {
    printf '%s\n' "$workflow must route the Windows lifecycle through the baseline verifier (missing $required)" >&2
    exit 1
  }
done
lifecycle_run="$(awk '
  /^      - name: Run native component lifecycle tests$/ { in_step=1; next }
  in_step && /^      - name:/ { exit }
  in_step && /^        run: \|$/ { in_run=1; next }
  in_step && in_run {
    line=$0
    sub(/^          /, "", line)
    print line
  }
' "$workflow")"
# Inspect the extracted native test block separately so baseline use and downloads stay constrained.
test -n "$lifecycle_run" || {
  printf '%s\n' "$workflow is missing the Windows native lifecycle run block" >&2
  exit 1
}
for required in \
  '& ./.github/scripts/verify-public-marketplace-baselines.ps1' \
  '$env:PYTHONPATH = "packages/getcodexy/src;packages/getcodexy/tests"'; do
  printf '%s\n' "$lifecycle_run" | grep -F -- "$required" >/dev/null || {
    printf '%s\n' "$workflow lifecycle must run baseline verification before native checks (missing $required)" >&2
    exit 1
  }
done
for required in \
  '& ./.github/scripts/verify-public-marketplace-baselines.ps1' \
  '$env:PYTHONPATH = "packages/getcodexy/src;packages/getcodexy/tests"'; do
  assignment="$(printf '%s\n' "$lifecycle_run" | grep -F -x -- "$required" || true)"
  test "$assignment" = "$required" || {
    printf '%s\n' "$workflow lifecycle has an unexpected baseline verifier command (unexpected $required assignment)" >&2
    exit 1
  }
done
for required in \
  'python scripts/verify_public_marketplace_bundle.py --output-dir $bundleRoot' \
  '--legacy-upgrade --output-dir $legacyRoot' \
  '$legacyRelease.legacy_watcher_binary' \
  '$legacyRelease.legacy_upgrade_fixture' \
  '$env:CODEXY_TEST_LEGACY_MARKETPLACE_ROOT = [string]$legacyRelease.extracted_root'; do
  grep -F -- "$required" "$baseline_script" >/dev/null || {
    printf '%s\n' "$baseline_script must bind only the verified legacy package to upgrade fixtures (missing $required)" >&2
    exit 1
  }
done
for forbidden in 'gh release' 'Invoke-WebRequest' 'Invoke-RestMethod' \
  'Start-BitsTransfer' 'System.Net.WebClient' 'releases/download/'; do
  if grep -F -- "$forbidden" "$baseline_script" >/dev/null; then
    printf '%s\n' "$baseline_script must keep public downloads inside the verifier (found $forbidden)" >&2
    exit 1
  fi
done
for forbidden in 'gh release' 'Invoke-WebRequest' 'Invoke-RestMethod' \
  'Start-BitsTransfer' 'System.Net.WebClient' 'releases/download/'; do
  if printf '%s\n' "$lifecycle_run" | grep -F -- "$forbidden" >/dev/null; then
    printf '%s\n' "$workflow lifecycle must not perform a direct public release operation (found $forbidden)" >&2
    exit 1
  fi
done
if printf '%s\n' "$lifecycle_run" | grep -Eq '(^|[^[:alnum:]])v?[0-9]+\.[0-9]+\.[0-9]+([^[:alnum:]]|$)'; then
  printf '%s\n' "$workflow lifecycle must not contain a literal release version" >&2
  exit 1
fi
for required in \
  'from public_marketplace_bundle_support import' \
  'CONTRACT,' \
  'LEGACY_UPGRADE_VERSION,' \
  'release_tag = current_tag' \
  'version = current_tag.removeprefix("v")' \
  '"gh",' \
  '"release",' \
  '"download",' \
  'runtime-release-receipt.json' \
  '--legacy-upgrade' \
  'legacy_watcher_binary' \
  'extracted_root'; do
  grep -F -- "$required" "$workflow_helper" >/dev/null || {
    printf '%s\n' "$workflow_helper must derive and verify the selected public release (missing $required)" >&2
    exit 1
  }
done
for required in \
  'CONTRACT = Path(".agents/plugins/release-publish-contract.json")' \
  'tarfile.open' \
  'archive.extract' \
  'runtime-release-receipt/v2' \
  'manifestSha256' \
  'LEGACY_UPGRADE_VERSION' \
  'if version == LEGACY_UPGRADE_VERSION:' \
  'watcher.exists()'; do
  grep -F -- "$required" "$workflow_support" >/dev/null || {
    printf '%s\n' "$workflow_support must provide public release verification support (missing $required)" >&2
    exit 1
  }
done
for path in "$workflow_helper" "$workflow_support"; do
  if grep -Eq "^[[:space:]]*version[[:space:]]*=[[:space:]]*[\"'][0-9]" "$path"; then
    printf '%s\n' "$path must not hard-code a public release version" >&2
    exit 1
  fi
done

if test -n "${GITHUB_ENV:-}"; then
  printf 'TARGET_VERSION=%s\nRELEASE_TAG=%s\n' "$target_version" "$release_tag" >> "$GITHUB_ENV"
else
  printf 'TARGET_VERSION=%s\nRELEASE_TAG=%s\n' "$target_version" "$release_tag"
fi
