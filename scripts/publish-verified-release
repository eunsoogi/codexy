#!/bin/sh
set -eu

: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${STAGING_SOURCE_COMMIT:?STAGING_SOURCE_COMMIT is required}"
: "${ACTIVATION_COMMIT:?ACTIVATION_COMMIT is required}"
: "${STAGING_RUN_ID:?STAGING_RUN_ID is required}"
: "${RELEASE_TAG:?RELEASE_TAG is required}"

git fetch --no-tags origin +refs/heads/main:refs/remotes/origin/main
test "$(git rev-parse "$STAGING_SOURCE_COMMIT")" = "$STAGING_SOURCE_COMMIT"
test "$(git rev-parse "$ACTIVATION_COMMIT")" = "$ACTIVATION_COMMIT"
test "$(jq -r .source.stagingSourceCommit dist/runtime-release-receipt.json)" = "$STAGING_SOURCE_COMMIT"
test "$(jq -r .source.activationCommit dist/runtime-release-receipt.json)" = "$ACTIVATION_COMMIT"
test "$(jq -r .staging.runId dist/runtime-release-receipt.json)" = "$STAGING_RUN_ID"
git merge-base --is-ancestor "$ACTIVATION_COMMIT" origin/main
release_state() {
  gh api "repos/$GITHUB_REPOSITORY/releases/$1" |
    jq '{id, name, tagName: .tag_name, targetCommitish: .target_commitish, isDraft: .draft, isPrerelease: .prerelease, uploadUrl: .upload_url, assets: [.assets[] | {id, name, size, digest}]}'
}
release_id_for_tag() {
  gh api "repos/$GITHUB_REPOSITORY/releases?per_page=100" |
    jq -er --arg tag "$RELEASE_TAG" '
      [.[] | select(.name == $tag or .tag_name == $tag)] as $matches |
      if ($matches | length) != 1 then error("release identity is not unique")
      elif ($matches[0].id | type) != "number" then error("release id is not numeric")
      elif $matches[0].name != $tag or $matches[0].tag_name != $tag then error("release identity mismatch")
      else $matches[0].id end'
}
validate_release_state() {
  test "$(jq -r .name release-state.json)" = "$RELEASE_TAG"
  test "$(jq -r .tagName release-state.json)" = "$RELEASE_TAG"
  test "$(jq -r .targetCommitish release-state.json)" = "$ACTIVATION_COMMIT"
  test "$(jq -r .isDraft release-state.json)" = true
  test "$(jq -r .isPrerelease release-state.json)" = false
  for name in $(jq -r '.assets[].name' release-state.json); do
    case "$name" in
    codexy-marketplace-plugin.tar.gz | codexy-marketplace-bundle.tar.gz | codexy-runtime-package.tar.gz | runtime-release-receipt.json) ;;
    release-baseline.json) ;;
    *) exit 1 ;;
    esac
  done
  if jq -e '.assets[] | select(.name == "release-baseline.json")' release-state.json > /dev/null; then
    for name in codexy-marketplace-plugin.tar.gz codexy-marketplace-bundle.tar.gz codexy-runtime-package.tar.gz runtime-release-receipt.json; do
      jq -e --arg name "$name" '.assets[] | select(.name == $name)' release-state.json > /dev/null
    done
  fi
}
release_create_diagnostic() {
  release_create_status="$1"
  release_create_response="$2"
  release_create_body="$(
    awk '
      $1 ~ /^HTTP\/[0-9.]+$/ { seen_status=1; next }
      seen_status && /^[[:space:]]*$/ { body=1; next }
      body { print }
    ' "$release_create_response" |
      sed -n '1,20p' |
      sed -E \
        -e '/[Aa]uthorization[[:space:]]*:/d' \
        -e '/[Bb]earer[[:space:]]/d' \
        -e '/[Gg][Hh]_[Tt][Oo][Kk][Ee][Nn]/d' \
        -e '/[Gg][Ii][Tt][Hh][Uu][Bb]_[Tt][Oo][Kk][Ee][Nn]/d' \
        -e '/[Tt]oken/d' |
      tr '\r\n' ' ' |
      cut -c 1-512
  )"
  release_create_status_line="$(awk '$1 ~ /^HTTP\/[0-9.]+$/ { print; exit }' "$release_create_response")"
  printf 'create-release status=%s response=%s\n' \
    "$release_create_status" "${release_create_status_line:-<empty>} body=${release_create_body:-<empty>}" >&2
}
release_create_id() {
  awk 'seen && /^[[:space:]]*$/ { body=1; next } body { print } $1 ~ /^HTTP\/[0-9.]+$/ { seen=1 }' "$1" |
    jq -er .id 2> /dev/null || jq -er .id "$1"
}
authenticated_remote_tag() {
  tag_auth_token="${GH_TOKEN:-unavailable}"
  tag_auth_basic="$(printf 'x-access-token:%s' "$tag_auth_token" | base64 | tr -d '\r\n')"
  GIT_CONFIG_COUNT=1 GIT_CONFIG_KEY_0=http.extraheader \
    GIT_CONFIG_VALUE_0="Authorization: Basic $tag_auth_basic" \
    git ls-remote --refs origin "$tag_ref"
}
verify_existing_tag() {
  tag_snapshot="$1"
  tag_snapshot_oid="$(printf '%s\n' "$tag_snapshot" | awk 'NR == 1 { print $1 }')"
  test "$tag_snapshot_oid" = "$ACTIVATION_COMMIT"
  git fetch --tags --force origin
  tag_snapshot_commit="$(git rev-parse --verify "$tag_ref^{commit}")"
  test "$tag_snapshot_commit" = "$ACTIVATION_COMMIT"
  test "$tag_snapshot" = "$(authenticated_remote_tag)"
  git fetch --no-tags origin +refs/heads/main:refs/remotes/origin/main
  test "$ACTIVATION_COMMIT" = "$(git rev-parse origin/main)"
  git merge-base --is-ancestor "$ACTIVATION_COMMIT" origin/main
}
verify_tag_if_present() {
  if test -n "$1"; then
    verify_existing_tag "$1"
  fi
}
retarget_existing_draft() {
  release_state "$1" > release-state.json
  retarget_target="$(jq -r .targetCommitish release-state.json)"
  test "$(jq -r .name release-state.json)" = "$RELEASE_TAG" || release_error "release identity mismatch"
  test "$(jq -r .tagName release-state.json)" = "$RELEASE_TAG" || release_error "release identity mismatch"
  test "$(jq -r .isDraft release-state.json)" = true || release_error "release identity mismatch"
  test "$(jq -r .isPrerelease release-state.json)" = false || release_error "release identity mismatch"
  if test "$retarget_target" = "$ACTIVATION_COMMIT"; then
    return 0
  fi
  test "$(jq '.assets | length' release-state.json)" -eq 0
  race_tag_snapshot="$(authenticated_remote_tag)"
  test -z "$race_tag_snapshot"
  case "$retarget_target" in *[!0-9a-f]*|'') release_error "draft target is not a commit" ;; esac
  test "${#retarget_target}" -eq 40
  git cat-file -e "$retarget_target^{commit}"
  git merge-base --is-ancestor "$retarget_target" "$ACTIVATION_COMMIT"
  git fetch --no-tags origin +refs/heads/main:refs/remotes/origin/main
  test "$ACTIVATION_COMMIT" = "$(git rev-parse origin/main)"
  gh api --method PATCH -H 'X-GitHub-Api-Version: 2026-03-10' \
    "repos/$GITHUB_REPOSITORY/releases/$1" -f "target_commitish=$ACTIVATION_COMMIT" > /dev/null
  release_state "$1" > release-state.json
  git fetch --no-tags origin +refs/heads/main:refs/remotes/origin/main
  test "$ACTIVATION_COMMIT" = "$(git rev-parse origin/main)"
}
release_error() {
  printf '%s\n' "$1" >&2
  exit 1
}
release_exists=false
release_id=
if gh release view "$RELEASE_TAG" --repo "$GITHUB_REPOSITORY" --json id,name,tagName,targetCommitish,isDraft,isPrerelease,assets > release-state.json 2>/dev/null; then
  release_exists=true
  release_id="$(release_id_for_tag)"
  test -n "$release_id"
fi
tag_ref="refs/tags/$RELEASE_TAG"
remote_tag="$(authenticated_remote_tag)"
if test "$release_exists" = true; then
  verify_tag_if_present "$remote_tag"
  retarget_existing_draft "$release_id"
fi
if test "$release_exists" = false; then
  changelog_notes="$(ACTIVATION_COMMIT="$ACTIVATION_COMMIT" scripts/generate-release-changelog "$RELEASE_TAG")"
  if test -n "$remote_tag"; then
    verify_tag_if_present "$remote_tag"
    verify_tag_if_present "$remote_tag"
  else
    test "$ACTIVATION_COMMIT" = "$(git rev-parse origin/main)"
  fi
  draft_release_response=draft-release-response.txt
  if release_create_response="$(gh api --method POST --include -H 'X-GitHub-Api-Version: 2026-03-10' \
    "repos/$GITHUB_REPOSITORY/releases" -f "tag_name=$RELEASE_TAG" \
    -f "target_commitish=$ACTIVATION_COMMIT" -f "name=$RELEASE_TAG" \
    -f "body=$changelog_notes" -F draft=true -F prerelease=false 2>&1)"; then
    release_create_exit=0
  else
    release_create_exit=$?
  fi
  printf '%s\n' "$release_create_response" > "$draft_release_response"
  release_create_status="$(awk '$1 ~ /^HTTP\/[0-9.]+$/ { print $2; exit }' "$draft_release_response")"
  test -n "$release_create_status" || release_create_status=unknown
  if test "$release_create_exit" -eq 0; then
    case "$release_create_status" in
    201 | unknown) release_id="$(release_create_id "$draft_release_response")" ;;
    *)
      release_create_diagnostic "$release_create_status" "$draft_release_response"
      release_id="$(release_id_for_tag)"
      ;;
    esac
  else
    release_create_diagnostic "$release_create_status" "$draft_release_response"
    release_id="$(release_id_for_tag)"
  fi
  case "$release_id" in '' | *[!0-9]*) release_error "release id is invalid" ;; esac
  release_exists=true
  rm -f "$draft_release_response"
  retarget_existing_draft "$release_id"
fi
release_state "$release_id" > release-state.json
validate_release_state
remote_tag="$(authenticated_remote_tag)"
verify_tag_if_present "$remote_tag"
release_asset_id() {
  jq -er --arg asset "$1" '
    [.assets[] | select(.name == $asset)] |
    if length == 1 then .[0].id else error("release asset identity is not unique") end
  ' release-state.json
}
release_upload_url() {
  jq -er .uploadUrl release-state.json | sed 's/{?name,label}$//'
}
upload_release_asset() {
  asset="$1"
  upload_url="$(release_upload_url)"
  gh api --method POST -H 'X-GitHub-Api-Version: 2026-03-10' -H 'Content-Type: application/octet-stream' \
    "$upload_url?name=$asset" --input "dist/$asset" > /dev/null
}
download_release_asset() {
  directory="$1"
  asset="$2"
  asset_id="$(release_asset_id "$asset")"
  case "$asset_id" in '' | *[!0-9]*) release_error "release asset id is invalid: $asset" ;; esac
  gh api -H 'X-GitHub-Api-Version: 2026-03-10' -H 'Accept: application/octet-stream' \
    "repos/$GITHUB_REPOSITORY/releases/assets/$asset_id" > "$directory/$asset"
}
verify_release_asset() {
  download_release_asset "$1" "$asset" || return 1
  cmp "dist/$asset" "$1/$asset" || release_error "release asset differs from verified bytes: $asset"
}
existing_release="$(mktemp -d)"
verified_release="$(mktemp -d)"
release_assets='codexy-marketplace-plugin.tar.gz codexy-marketplace-bundle.tar.gz codexy-runtime-package.tar.gz runtime-release-receipt.json'
for asset in $release_assets; do
  if jq -e --arg asset "$asset" '.assets[] | select(.name == $asset)' release-state.json > /dev/null; then
    verify_release_asset "$existing_release"
  fi
done
for asset in $release_assets; do
  if ! jq -e --arg asset "$asset" '.assets[] | select(.name == $asset)' release-state.json > /dev/null; then
    upload_release_asset "$asset"
  fi
done
case "$release_id" in '' | *[!0-9]*) release_error "release id is invalid" ;; esac
release_state "$release_id" > release-state.json
remote_tag="$(authenticated_remote_tag)"
verify_tag_if_present "$remote_tag"
for asset in $release_assets; do
  jq -e --arg asset "$asset" '.assets[] | select(.name == $asset)' release-state.json > /dev/null || release_error "release asset is missing after reconciliation: $asset"
  verify_release_asset "$verified_release"
done
if test -n "${GITHUB_ENV:-}"; then
  printf 'RELEASE_ID=%s\n' "$release_id" >> "$GITHUB_ENV"
fi
RELEASE_ID="$release_id" scripts/reconcile-release-baseline
remote_tag="$(authenticated_remote_tag)"
verify_tag_if_present "$remote_tag"
