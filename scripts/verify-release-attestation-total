#!/bin/sh
set -eu

: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${ACTIVATION_COMMIT:?ACTIVATION_COMMIT is required}"
artifact="${1:?artifact is required}"
expected="${2:?expected attestation count is required}"
case "$expected" in *[!0-9]*|'') exit 2 ;; esac
name="$(basename "$artifact")"
if test "$name" = codexy-runtime-package.tar.gz; then
  : "${STAGING_SOURCE_COMMIT:?STAGING_SOURCE_COMMIT is required for the runtime candidate subject}"
  signer="$GITHUB_REPOSITORY/.github/workflows/runtime-candidate.yml"
  source_digest="$STAGING_SOURCE_COMMIT"
else
  signer="$GITHUB_REPOSITORY/.github/workflows/publish-version-release.yml"
  source_digest="$ACTIVATION_COMMIT"
fi
gh attestation verify "$artifact" --repo "$GITHUB_REPOSITORY" \
  --signer-workflow "$signer" --source-ref refs/heads/main \
  --source-digest "$source_digest" --deny-self-hosted-runners \
  --limit 1000 \
  --format json > "$artifact.attestations.json"
jq -e --argjson expected "$expected" 'length == $expected and all(.[]; .verificationResult.statement.subject | length == 1)' "$artifact.attestations.json" >/dev/null
