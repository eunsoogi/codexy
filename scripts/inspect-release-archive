#!/bin/sh
set -eu

archive=${1:?archive path required}
plugin_root=${2:?staged plugin root required}
max_bytes=${MAX_ARCHIVE_FILE_BYTES:-52428800}
max_entries=${MAX_ARCHIVE_ENTRIES:-10000}
max_total_bytes=${MAX_ARCHIVE_TOTAL_BYTES:-268435456}
script_dir=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

command -v tar >/dev/null 2>&1 || { echo "tar is required" >&2; exit 127; }
command -v python3 >/dev/null 2>&1 || { echo "python3 is required" >&2; exit 127; }
if command -v sha256sum >/dev/null 2>&1; then
  digest_file() { sha256sum "$1" | awk '{print $1}'; }
elif command -v shasum >/dev/null 2>&1; then
  digest_file() { shasum -a 256 "$1" | awk '{print $1}'; }
else
  echo "sha256sum or shasum is required" >&2
  exit 127
fi
response_checker="$script_dir/inspect-mcp-response"
[ -x "$response_checker" ] || { echo "MCP response checker missing" >&2; exit 1; }
[ -f "$archive" ] || { echo "archive missing: $archive" >&2; exit 1; }
[ -d "$plugin_root" ] || { echo "staged plugin root missing: $plugin_root" >&2; exit 1; }

tmp_dir=$(mktemp -d)
trap 'rm -rf "$tmp_dir"' EXIT HUP INT TERM
if [ -f "$plugin_root/.mcp.json" ]; then
  "$script_dir/inspect-mcp-entrypoints" "$plugin_root/.mcp.json" >"$tmp_dir/mcp-entrypoints"
  "$script_dir/check-release-archive-entries" "$archive" "$max_bytes" "$max_entries" "$max_total_bytes" "$tmp_dir/mcp-entrypoints"
else
  "$script_dir/check-release-archive-entries" "$archive" "$max_bytes" "$max_entries" "$max_total_bytes"
  "$script_dir/inspect-mcp-entrypoints" "$plugin_root/.mcp.json" >"$tmp_dir/mcp-entrypoints"
fi

extract_root="$tmp_dir/extracted"
mkdir "$extract_root"
tar --no-same-owner --no-same-permissions -xzf "$archive" -C "$extract_root"
release_contract="$extract_root/plugins/codexy/runtime-release.json"
[ -f "$release_contract" ] || { echo "packaged runtime-release.json missing" >&2; exit 1; }
release_state=$(python3 - "$release_contract" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as source:
    contract = json.load(source)
print(contract.get("state", ""))
PY
)
case "$release_state" in
  legacy-public) ;;
  candidate-proven)
    candidate_contract="$extract_root/plugins/codexy/runtime-candidate.json"
    [ -f "$candidate_contract" ] || { echo "candidate-proven package lacks runtime-candidate.json" >&2; exit 1; }
    expected_candidate_sha=$(python3 - "$release_contract" <<'PY'
import json, sys
with open(sys.argv[1], encoding="utf-8") as source:
    print(json.load(source)["artifact"]["payloadManifestSha256"])
PY
)
    actual_candidate_sha=$(digest_file "$candidate_contract")
    [ "$expected_candidate_sha" = "$actual_candidate_sha" ] || { echo "runtime-candidate.json digest differs from payload manifest" >&2; exit 1; }
    ;;
  *) echo "invalid runtime-release state: $release_state" >&2; exit 1 ;;
esac
"$script_dir/validate-plugin-config" --plugin-root "$extract_root/plugins/codexy" --check-runtime-artifacts
mkdir -p "$extract_root/tests/suites"
: > "$extract_root/tests/suites/all.rs"
"$script_dir/validate-plugin-config" --plugin-root "$extract_root/plugins/codexy" --check-hooks
(cd "$extract_root/plugins/codexy" && find . -type f | sed 's#^./##' | sort) >"$tmp_dir/actual"
python3 - "$release_contract" "$release_state" >"$tmp_dir/expected-runtime" <<'PY'
import json, sys

contract_path, state = sys.argv[1:]
try:
    with open(contract_path, encoding="utf-8") as source:
        platforms = json.load(source)["platforms"]
    expected_platforms = (
        ("darwin-arm64", "linux-x86_64")
        if state == "legacy-public"
        else ("darwin-arm64", "linux-x86_64", "windows-x86_64")
    )
    if set(platforms) != set(expected_platforms):
        raise ValueError("platform set")
    for platform in expected_platforms:
        extension = "exe" if platform == "windows-x86_64" else "bin"
        for server in ("lsp", "codegraph"):
            expected = f"runtime/codexy-mcp-{server}-{platform}.{extension}"
            artifact = platforms[platform][server]
            if state == "candidate-proven" and artifact.get("path") != expected:
                raise ValueError("candidate runtime path")
            print(expected)
except (KeyError, TypeError, ValueError, json.JSONDecodeError):
    raise SystemExit("runtime release artifact contract is invalid")
PY
while IFS= read -r relative; do
  case "$relative" in runtime/*)
    grep -Fxq "$relative" "$tmp_dir/expected-runtime" || {
      echo "unexpected runtime artifact: $relative" >&2
      exit 1
    }
  esac
done <"$tmp_dir/actual"
source_check_root="$tmp_dir/source-check/plugins/codexy"
mkdir -p "$source_check_root"
mkdir -p "$tmp_dir/source-check/tests/suites"
: > "$tmp_dir/source-check/tests/suites/all.rs"
tar -C "$extract_root/plugins/codexy" --exclude=runtime -cf - . | tar -C "$source_check_root" -xf -
"$script_dir/validate-plugin-config" --plugin-root "$source_check_root" --check
if find "$extract_root/plugins/codexy" \( -name .git -o -name target -o -name '*.dSYM' -o -name '*.debug' \) -print -quit | grep -q .; then
  echo "archive contains a debug artifact" >&2
  exit 1
fi
(cd "$plugin_root" && find . -type f | sed 's#^./##' | sort) >"$tmp_dir/expected"
diff -u "$tmp_dir/expected" "$tmp_dir/actual"
(cd "$extract_root/plugins/codexy" && find . -type d | sed 's#^./##') >"$tmp_dir/directories"
while IFS= read -r relative; do
  case "$relative" in
    runtime) ;;
    runtime/*) echo "unexpected runtime directory: $relative" >&2; exit 1 ;;
  esac
done <"$tmp_dir/directories"

python3 "$script_dir/check-release-archive-content" "$tmp_dir/expected" "$plugin_root" "$extract_root/plugins/codexy"

if find "$extract_root/plugins/codexy" -type f -size "+${max_bytes}c" -print -quit | grep -q .; then
  echo "archive contains an oversized file" >&2
  exit 1
fi
hygiene_pattern='(BEGIN( [A-Z0-9]+)* PRIVATE KEY|(AKIA|ASIA)[0-9A-Z]{16})'
# A leading slash is an MSYS path-conversion candidate when this reaches native
# rg.exe through Git Bash. The character class still matches only a slash.
local_path_pattern='[\/](Users|home|tmp|private/var)/'
scan_output="$tmp_dir/archive-scan-output"
inventory="$extract_root/plugins/codexy/hooks/policy-inventory.json"
set +e
MSYS2_ENV_CONV_EXCL=LOCAL_PATH_PATTERN LOCAL_PATH_PATTERN="$local_path_pattern" python3 - "$inventory" <<'PY'
import json, os, re, sys

try:
    inventory = json.load(open(sys.argv[1], encoding="utf-8"))
    rules = inventory["rules"]
    if not isinstance(rules, list):
        raise ValueError("rules must be a list")
    pattern = re.compile(os.environ["LOCAL_PATH_PATTERN"])
    def contains_local_path(value):
        if isinstance(value, str):
            return pattern.search(value) is not None
        if isinstance(value, list):
            return any(contains_local_path(item) for item in value)
        if isinstance(value, dict):
            return any(contains_local_path(item) for item in value.values())
        return False
    semantic_inventory = dict(inventory)
    semantic_inventory["rules"] = [
        {key: value for key, value in rule.items() if key not in {"source", "text"}}
        if isinstance(rule, dict) else rule
        for rule in rules
    ]
    unsafe = contains_local_path(semantic_inventory)
except (OSError, ValueError, KeyError, TypeError, json.JSONDecodeError):
    raise SystemExit(2)
raise SystemExit(1 if unsafe else 0)
PY
inventory_path_status=$?
set -e
case "$inventory_path_status" in
  0) ;;
  1) echo "archive contains a secret or local path" >&2; exit 1 ;;
  *) echo "archive policy inventory hygiene scan failed: status $inventory_path_status" >&2; exit 1 ;;
esac
scan_archive_content() {
  "$@" >"$scan_output" 2>&1
}
scan_grep_content() {
  pattern=$1
  shift
  find "$extract_root/plugins/codexy" -type f ! -path "$extract_root/plugins/codexy/runtime/*.bin" "$@" \
    -exec grep -a -Hn -E "$pattern" {} +
}
if command -v rg >/dev/null 2>&1; then
  set +e
  scan_archive_content rg -a -n --hidden --no-ignore --glob '!**/runtime/*.bin' "$hygiene_pattern" "$extract_root/plugins/codexy"
  hygiene_status=$?
  scan_archive_content rg -a -n --hidden --no-ignore --glob '!**/runtime/*.bin' --glob '!**/hooks/policy-inventory.json' --glob '!*.md' --glob '!*.txt' "$local_path_pattern" "$extract_root/plugins/codexy"
  local_path_status=$?
  set -e
else
  command -v grep >/dev/null 2>&1 || { echo "rg or grep is required" >&2; exit 127; }
  set +e
  scan_archive_content scan_grep_content "$hygiene_pattern"
  hygiene_status=$?
  scan_archive_content scan_grep_content "$local_path_pattern" ! -path "$extract_root/plugins/codexy/hooks/policy-inventory.json" ! -name '*.md' ! -name '*.txt'
  local_path_status=$?
  set -e
fi
case "$hygiene_status" in
  0) echo "archive contains a secret or local path" >&2; exit 1 ;;
  1) ;;
  *) echo "archive hygiene scan failed: status $hygiene_status" >&2; exit 1 ;;
esac
case "$local_path_status" in
  0) echo "archive contains a secret or local path" >&2; exit 1 ;;
  1) ;;
  *) echo "archive local-path scan failed: status $local_path_status" >&2; exit 1 ;;
esac

printf 'archive_sha256 '
digest_file "$archive"

platform=$(uname -s | tr '[:upper:]' '[:lower:]')-$(uname -m | sed 's/aarch64/arm64/;s/amd64/x86_64/')
for server in lsp codegraph; do
  runtime="$extract_root/plugins/codexy/runtime/codexy-mcp-$server-$platform.bin"
  if [ -x "$runtime" ]; then
    response_file="$tmp_dir/${server}-response"
    set +e
    RUNTIME="$runtime" RESPONSE_FILE="$response_file" python3 - <<'PY'
import os, subprocess
requests = """{"jsonrpc":"2.0","id":1,"method":"initialize","params":{"protocolVersion":"2024-11-05","capabilities":{},"clientInfo":{"name":"archive-smoke","version":"1"}}}
{"jsonrpc":"2.0","method":"notifications/initialized"}
{"jsonrpc":"2.0","id":2,"method":"tools/list","params":{}}
"""
try:
    completed = subprocess.run([os.environ["RUNTIME"], "--stdio"], input=requests,
                               text=True, capture_output=True, timeout=15, check=True)
    open(os.environ["RESPONSE_FILE"], "w", encoding="utf-8").write(completed.stdout)
except (subprocess.SubprocessError, OSError) as error:
    print(error)
    raise SystemExit(124)
PY
    status=$?
    set -e
    [ "$status" -eq 0 ] || { echo "$server MCP process failed: $status" >&2; exit 1; }
    "$response_checker" "$response_file" "$server"
  else
    echo "${server} native smoke skipped: no executable $platform runtime"
  fi
done
