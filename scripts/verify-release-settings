#!/bin/sh
set -eu

require_pypi=false
if test "${1:-}" = --require-pypi; then
  require_pypi=true
elif test "$#" -ne 0; then
  printf '%s\n' 'usage: verify-release-settings [--require-pypi]' >&2
  exit 2
fi

: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${RELEASE_POLICY_TOKEN:?CODEXY_RELEASE_POLICY_TOKEN is required}"
export GH_TOKEN="$RELEASE_POLICY_TOKEN"
api_version='X-GitHub-Api-Version: 2026-03-10'
immutable="$(gh api -H "$api_version" "repos/$GITHUB_REPOSITORY/immutable-releases")"
test "$(printf '%s' "$immutable" | jq -r .enabled)" = true || {
  printf '%s\n' 'immutable releases must be enabled before publication' >&2
  exit 1
}

if test "$require_pypi" = true; then
  environment="$(gh api -H "$api_version" "repos/$GITHUB_REPOSITORY/environments/pypi")"
  printf '%s' "$environment" | jq -e '
    .deployment_branch_policy.protected_branches == true and
    .deployment_branch_policy.custom_branch_policies == false and
    .can_admins_bypass == false and
    ([.protection_rules[]? | select(
      .type == "required_reviewers" and
      .prevent_self_review == true and
      (.reviewers | type == "array") and
      (.reviewers | length > 0) and
      (.reviewers | all(.[]; (.reviewer.login | type) == "string" and (.reviewer.login | length > 0)))
    )] | length == 1) and
    ([.protection_rules[]?.type] | sort | unique == ["branch_policy", "required_reviewers"])
  ' >/dev/null || {
    printf '%s\n' 'pypi environment must require protected branches and maintainer approval' >&2
    exit 1
  }
  printf '%s' "$environment" | jq -r '[.protection_rules[] | select(.type == "required_reviewers") | .reviewers[]?.reviewer.login] | unique[]' | while IFS= read -r reviewer; do
    test -n "$reviewer"
    permission="$(gh api -H "$api_version" "repos/$GITHUB_REPOSITORY/collaborators/$reviewer/permission" --jq .permission)"
    case "$permission" in admin|maintain) ;; *) exit 1 ;; esac
  done
fi
