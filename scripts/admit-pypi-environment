#!/bin/sh
set -eu

: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${GH_TOKEN:?GH_TOKEN is required}"
api_version='X-GitHub-Api-Version: 2026-03-10'
environment="$(gh api -H "$api_version" "repos/$GITHUB_REPOSITORY/environments/pypi")"
printf '%s' "$environment" | jq -e '
  .name == "pypi" and
  .deployment_branch_policy.protected_branches == true and
  .deployment_branch_policy.custom_branch_policies == false and
  .can_admins_bypass == false and
  (.protection_rules as $rules
   | if ($rules | type) != "array" then false
     else
       ([$rules[] | select(.type == "required_reviewers")]) as $reviewer_rules
       | ([$rules[] | select(.type == "branch_policy")]) as $branch_rules
       | ($reviewer_rules[0]) as $review_rule
       | ($rules | length == 2) and
         ($reviewer_rules | length == 1) and
         ($branch_rules | length == 1) and
         ($rules | all(.[]; .type == "required_reviewers" or .type == "branch_policy")) and
         (($review_rule.prevent_self_review | type) == "boolean") and
         (($review_rule.reviewers | type) == "array") and
         (($review_rule.reviewers | length) > 0) and
         ($review_rule.reviewers | all(.[]; (.reviewer.login | type) == "string" and (.reviewer.login | length > 0)))
     end)
' >/dev/null

reviewers="$(printf '%s' "$environment" | jq -r '[.protection_rules[] | select(.type == "required_reviewers") | .reviewers[]?.reviewer.login] | unique[]')"
test -n "$reviewers"
printf '%s\n' "$reviewers" | while IFS= read -r reviewer; do
  test -n "$reviewer"
  permission="$(gh api -H "$api_version" "repos/$GITHUB_REPOSITORY/collaborators/$reviewer/permission" --jq '.role_name // .permission')"
  case "$permission" in
    admin|maintain) ;;
    *) printf 'required PyPI reviewer lacks maintain/admin access: %s\n' "$reviewer" >&2; exit 1 ;;
  esac
done
