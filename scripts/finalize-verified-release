#!/bin/sh
set -eu

: "${GITHUB_REPOSITORY:?GITHUB_REPOSITORY is required}"
: "${RELEASE_TAG:?RELEASE_TAG is required}"
: "${RELEASE_ID:?RELEASE_ID is required}"
: "${ACTIVATION_COMMIT:?ACTIVATION_COMMIT is required}"
case "$RELEASE_ID" in ''|*[!0-9]*) exit 1 ;; esac
signer="$GITHUB_REPOSITORY/.github/workflows/publish-version-release.yml"
runtime_signer="$GITHUB_REPOSITORY/.github/workflows/runtime-candidate.yml"
final_release="$(mktemp -d)"
release_state() {
  gh api -H 'X-GitHub-Api-Version: 2026-03-10' "repos/$GITHUB_REPOSITORY/releases/$RELEASE_ID" |
    jq '{id, name, tagName: .tag_name, targetCommitish: .target_commitish, isDraft: .draft, isPrerelease: .prerelease, uploadUrl: .upload_url, assets}'
}
release_upload_url() {
  jq -er .uploadUrl release-state.json | sed 's/{?name,label}$//'
}
upload_release_asset() {
  asset="$1"
  upload_url="$(release_upload_url)"
  gh api --method POST -H 'X-GitHub-Api-Version: 2026-03-10' -H 'Content-Type: application/octet-stream' \
    "$upload_url?name=$asset" --input "dist/$asset" >/dev/null
}
release_state > release-state.json
if test "${BASELINE_CREATED:-false}" = true; then
  upload_release_asset release-baseline.json
fi
release_state > release-state.json
for name in $(jq -r '.assets[].name' release-state.json); do
  case "$name" in codexy-marketplace-plugin.tar.gz|codexy-marketplace-bundle.tar.gz|codexy-runtime-package.tar.gz|runtime-release-receipt.json|release-baseline.json) ;; *) exit 1 ;; esac
done
download_release_asset() {
  asset="$1"
  asset_id="$(jq -er --arg asset "$asset" '
    [.assets[] | select(.name == $asset)] |
    if length == 1 then .[0].id else error("release asset identity is not unique") end
  ' release-state.json)"
  case "$asset_id" in ''|*[!0-9]*) exit 1 ;; esac
  gh api -H 'X-GitHub-Api-Version: 2026-03-10' -H 'Accept: application/octet-stream' \
    "repos/$GITHUB_REPOSITORY/releases/assets/$asset_id" > "$final_release/$asset"
}
for asset in codexy-marketplace-plugin.tar.gz codexy-marketplace-bundle.tar.gz codexy-runtime-package.tar.gz runtime-release-receipt.json release-baseline.json; do
  jq -e --arg asset "$asset" '.assets[] | select(.name == $asset)' release-state.json >/dev/null
  download_release_asset "$asset"
  if test "$asset" = release-baseline.json; then
    scripts/verify-release-attestation-total "$final_release/$asset" 1
  fi
done
staging_source_commit="$(jq -er .source.stagingSourceCommit "$final_release/runtime-release-receipt.json")"
STAGING_SOURCE_COMMIT="$staging_source_commit" scripts/verify-release-attestation-set "$final_release" final-attestations.json
jq -e --slurpfile baseline "$final_release/release-baseline.json" --slurpfile attestations final-attestations.json --arg signer "$signer" --arg runtimeSigner "$runtime_signer" --arg activation "$ACTIVATION_COMMIT" --arg staging "$staging_source_commit" '
  . as $release | $baseline[0] as $expected |
  ($release.id == $expected.release.id) and ($release.name == $expected.release.name) and
  ($release.tagName == $expected.release.tagName) and ($release.targetCommitish == $expected.release.targetCommitish) and
  (($release.isDraft == true) or ($release.isDraft == $expected.release.isDraft)) and
  ($release.isPrerelease == $expected.release.isPrerelease) and
  ([.assets[] | select(.name != "release-baseline.json") | {name, size, digest}] | sort_by(.name) == $expected.assets) and
  ($expected.releaseReceiptSha256 == ([.assets[] | select(.name == "runtime-release-receipt.json") | .digest | sub("^sha256:"; "")][0])) and
  ($expected.attestationPolicies == {
    "codexy-marketplace-plugin.tar.gz": {signerWorkflow: $signer, sourceRef: "refs/heads/main", sourceDigest: $activation, denySelfHostedRunners: true},
    "codexy-marketplace-bundle.tar.gz": {signerWorkflow: $signer, sourceRef: "refs/heads/main", sourceDigest: $activation, denySelfHostedRunners: true},
    "codexy-runtime-package.tar.gz": {signerWorkflow: $runtimeSigner, sourceRef: "refs/heads/main", sourceDigest: $staging, denySelfHostedRunners: true},
    "runtime-release-receipt.json": {signerWorkflow: $signer, sourceRef: "refs/heads/main", sourceDigest: $activation, denySelfHostedRunners: true}
  }) and
  ($expected.attestations == $attestations[0])
' release-state.json >/dev/null
if test "$(jq -r .isDraft release-state.json)" = true; then
  gh api --method PATCH -H 'X-GitHub-Api-Version: 2026-03-10' \
    "repos/$GITHUB_REPOSITORY/releases/$RELEASE_ID" -F draft=false >/dev/null
fi
gh api -H 'X-GitHub-Api-Version: 2026-03-10' "repos/$GITHUB_REPOSITORY/releases/$RELEASE_ID" > final-release-state.json
jq -e --slurpfile baseline "$final_release/release-baseline.json" '
  . as $release | $baseline[0] as $expected |
  ($release.immutable == true) and ($release.id == $expected.release.id) and
  ($release.name == $expected.release.name) and ($release.tag_name == $expected.release.tagName) and
  ($release.target_commitish == $expected.release.targetCommitish) and
  ($release.draft == $expected.release.isDraft) and ($release.prerelease == $expected.release.isPrerelease) and
  ([.assets[] | select(.name != "release-baseline.json") | {name, size, digest}] | sort_by(.name) == $expected.assets) and
  ([.assets[].name] | sort == ["codexy-marketplace-bundle.tar.gz", "codexy-marketplace-plugin.tar.gz", "codexy-runtime-package.tar.gz", "release-baseline.json", "runtime-release-receipt.json"])
' final-release-state.json >/dev/null
