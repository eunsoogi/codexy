#!/bin/sh
set -eu

: "${GITHUB_REPOSITORY:?}"
output=${1:?selected runtime archive path required}
record=.agents/plugins/runtime-activation.json
release_contract=.agents/plugins/release-publish-contract.json
legacy_release=plugins/codexy-devtools/runtime-release.json
marker_dir=$(dirname -- "$output")
mkdir -p "$marker_dir"
test ! -e "$output"
test ! -e "$marker_dir/public-release"
test ! -e "$marker_dir/legacy-public"

if command -v sha256sum >/dev/null 2>&1; then
  digest_file() { sha256sum "$1" | awk '{print $1}'; }
elif command -v shasum >/dev/null 2>&1; then
  digest_file() { shasum -a 256 "$1" | awk '{print $1}'; }
else
  echo "sha256sum or shasum is required" >&2
  exit 127
fi

download_legacy() {
  test "$(jq -er .state "$legacy_release")" = legacy-public
  test "$(jq -er .artifact.tag "$legacy_release")" = "$RELEASE_TAG"
  url="$(jq -er .artifact.url "$legacy_release")"
  digest="$(jq -er .artifact.sha256 "$legacy_release")"
  expected_url="https://github.com/$GITHUB_REPOSITORY/releases/download/$RELEASE_TAG/codexy-marketplace-plugin.tar.gz"
  test "$url" = "$expected_url"
  curl --fail --location "$url" -o "$output"
  test "$(digest_file "$output")" = "$digest"
  : > "$marker_dir/legacy-public"
}

download_public() {
  mkdir public-release
  gh release download "$RELEASE_TAG" --repo "$GITHUB_REPOSITORY" \
    --dir public-release --pattern codexy-marketplace-plugin.tar.gz \
    --pattern runtime-release-receipt.json
  if test -f public-release/runtime-release-receipt.json; then
    receipt=public-release/runtime-release-receipt.json
    test "$(jq -r .release.tag "$receipt")" = "$RELEASE_TAG"
    test "$(jq -r .source.stagingSourceCommit "$receipt")" = "$(jq -r .candidate.source.commit "$record")"
    test "$(jq -r .staging.runId "$receipt")" = "$(jq -r .candidate.artifact.stagingRunId "$record")"
    test "$(jq -r .staging.runAttempt "$receipt")" = "$(jq -r .candidate.artifact.stagingRunAttempt "$record")"
    jq -cS .provenance "$receipt" | tr -d '\n' > public-provenance.json
    jq -cS .provenance "$record" | tr -d '\n' > activated-provenance.json
    cmp public-provenance.json activated-provenance.json || {
      printf '%s\n' "public release receipt does not match activated staging identity" >&2
      exit 1
    }
    cp public-release/codexy-marketplace-plugin.tar.gz "$output"
    test "$(digest_file "$output")" = "$(jq -r .artifact.sha256 "$receipt")"
    : > "$marker_dir/public-release"
  else
    download_legacy
  fi
}

if test -f "$record"; then
  RELEASE_TAG="$(jq -er .runtime.selectedTag "$release_contract")"
  export RELEASE_TAG
  if gh release view "$RELEASE_TAG" --repo "$GITHUB_REPOSITORY" >/dev/null 2> release-view-error; then
    download_public
  else
    release_status=$?
    if ! grep -Eq 'HTTP 404|release not found' release-view-error; then
      cat release-view-error >&2
      exit "$release_status"
    fi
    export STAGING_RUN_ID="$(jq -er .candidate.artifact.stagingRunId "$record")"
    export SOURCE_COMMIT="$(jq -er .candidate.source.commit "$record")"
    scripts/download-runtime-staging-artifact staging
    cp staging/codexy-marketplace-plugin.tar.gz "$output"
    test "$(digest_file "$output")" = "$(jq -er .artifact.sha256 "$record")"
  fi
  rm -f release-view-error
else
  RELEASE_TAG="$(jq -er .artifact.tag "$legacy_release")"
  export RELEASE_TAG
  download_legacy
fi
