#!/usr/bin/env python3
"""Run and enforce the exact complete Rust test workload once."""

from __future__ import annotations

import argparse
import json
import os
import re
import signal
import subprocess
import sys
import threading
import time
from collections import Counter
from pathlib import Path

from profile_rust_accounting import (
    listed_test_inventory_from_completed_binaries,
    observed_test_inventory,
    observed_test_outcomes,
)
from profile_rust_workflow import enforce_workflow_contract

BUDGET_SECONDS = 180.0
WINDOWS_BUDGET_SECONDS = 540.0
MINIMUM_PASSED_TESTS = 1802
REQUIRED_JOB_TIMEOUT_MINUTES = 4
REQUIRED_WINDOWS_JOB_TIMEOUT_MINUTES = 10
WORKLOAD = ("cargo", "test", "--locked", "--all-targets")
COMPILE_PATTERN = re.compile(r"Finished `test` profile .* in (?:(\d+)m )?([0-9.]+)s")
RESULT_PATTERN = re.compile(
    r"test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed; "
    r"(\d+) ignored; \d+ measured; \d+ filtered out"
)

def archive_fixture_nested_cargo_build_count(root: Path) -> int:
    helper = root / "tests/support/release_archive.rs"
    try:
        source = helper.read_text()
    except OSError as error:
        sys.stderr.write(f"archive fixture helper is unreadable: {error}\n")
        raise SystemExit(1) from None
    return source.count('Command::new("cargo")')
def run_workload(root: Path, budget_seconds: float) -> tuple[str, float, int]:
    started = time.perf_counter()
    process = subprocess.Popen(
        WORKLOAD,
        cwd=root,
        stdout=subprocess.PIPE,
        stderr=subprocess.STDOUT,
        start_new_session=os.name == "posix",
    )
    output: list[bytes] = []

    def stream_output() -> None:
        assert process.stdout is not None
        first_line = process.stdout.readline()
        if first_line:
            output.append(first_line)
            sys.stdout.write(first_line.decode("utf-8"))
            sys.stdout.flush()
        remaining = process.stdout.read()
        if remaining:
            output.append(remaining)
            sys.stdout.write(remaining.decode("utf-8"))
        sys.stdout.flush()

    reader = threading.Thread(target=stream_output, name="cargo-test-output", daemon=True)
    reader.start()
    try:
        status = process.wait(timeout=budget_seconds)
    except subprocess.TimeoutExpired:
        terminate_workload(process)
        status = 124
    except KeyboardInterrupt:
        terminate_workload(process)
        raise
    finally:
        reader.join()
    output_text = b"".join(output).decode("utf-8")
    if status == 124:
        return output_text, budget_seconds, 124
    elapsed = time.perf_counter() - started
    return output_text, elapsed, status


def terminate_workload(process: subprocess.Popen[str]) -> None:
    if process.poll() is not None:
        return
    if os.name == "posix":
        os.killpg(process.pid, signal.SIGKILL)
    else:
        process.kill()
    process.wait()
def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--workflow-file", type=Path)
    parser.add_argument("--budget-seconds", type=float, default=BUDGET_SECONDS)
    parser.add_argument("--verify-coverage", action="store_true")
    parser.add_argument("--windows", action="store_true")
    arguments = parser.parse_args()
    root = arguments.root.resolve()
    if arguments.windows:
        arguments.verify_coverage = True
        arguments.budget_seconds = WINDOWS_BUDGET_SECONDS
    workflow = arguments.workflow_file or root / ".github/workflows/rust-test.yml"
    enforce_workflow_contract(
        workflow, REQUIRED_JOB_TIMEOUT_MINUTES, REQUIRED_WINDOWS_JOB_TIMEOUT_MINUTES, WORKLOAD
    )
    archive_fixture_nested_cargo_builds = archive_fixture_nested_cargo_build_count(root)
    started = time.perf_counter()
    output, elapsed, status = run_workload(root, arguments.budget_seconds)
    expected_tests: Counter[str] = Counter()
    expected_targets: set[str] = set()
    inventory_status = 0
    inventory_seconds = 0.0
    if arguments.verify_coverage:
        inventory_started = time.perf_counter()
        (expected_tests, expected_targets), inventory_status = (
            listed_test_inventory_from_completed_binaries(root, output)
        )
        inventory_seconds = time.perf_counter() - inventory_started
    outcomes = observed_test_outcomes(output)
    if not outcomes and not arguments.verify_coverage:
        for passed, failed, ignored in RESULT_PATTERN.findall(output):
            outcomes.update({"ok": int(passed), "FAILED": int(failed), "ignored": int(ignored)})
    passed = outcomes["ok"]
    failed = outcomes["FAILED"]
    ignored = outcomes["ignored"]
    compile_matches = COMPILE_PATTERN.findall(output)
    compile_seconds = (
        int(compile_matches[-1][0] or 0) * 60 + float(compile_matches[-1][1])
        if compile_matches
        else 0.0
    )
    execution_seconds = max(0.0, elapsed - compile_seconds)
    target_pass = bool(expected_targets) if arguments.verify_coverage else True
    tests_pass = passed >= MINIMUM_PASSED_TESTS and failed == 0 and ignored == 0
    archive_fixture_nested_cargo_pass = archive_fixture_nested_cargo_builds == 0
    observed_tests, observed_targets = observed_test_inventory(output)
    missing = sorted((expected_tests - observed_tests).elements())
    unexpected = observed_tests - expected_tests
    duplicate = sorted(
        name
        for name, count in unexpected.items()
        if expected_tests[name] > 0
        for _ in range(count)
    )
    extra = sorted(
        name
        for name, count in unexpected.items()
        if expected_tests[name] == 0
        for _ in range(count)
    )
    coverage_pass = (
        not arguments.verify_coverage
        or (
            inventory_status == 0
            and expected_tests
            and not missing
            and not duplicate
            and not extra
            and expected_targets == observed_targets
        )
    )
    total_elapsed = time.perf_counter() - started
    budget_pass = total_elapsed <= arguments.budget_seconds
    print(f"command\t{' '.join(WORKLOAD)}")
    print("workload-invocations\t1")
    if arguments.verify_coverage:
        print(f"compiled-targets\t{len(expected_targets)}\t{'PASS' if target_pass else 'FAIL'}")
    print(f"tests\t{passed} passed\t{failed} failed\t{ignored} ignored\t{'PASS' if tests_pass else 'FAIL'}")
    print(
        "archive-fixture-nested-cargo-builds"
        f"\t{archive_fixture_nested_cargo_builds}"
        f"\t{'PASS' if archive_fixture_nested_cargo_pass else 'FAIL'}"
    )
    print(f"compile-seconds\t{compile_seconds:.3f}")
    print(f"execution-seconds\t{execution_seconds:.3f}")
    if arguments.verify_coverage:
        print(f"inventory-seconds\t{inventory_seconds:.3f}")
    print(f"total-seconds\t{total_elapsed:.3f}")
    if arguments.verify_coverage:
        print(f"coverage-tests\t{sum(expected_tests.values())}\t{sum(observed_tests.values())}\t{'PASS' if coverage_pass else 'FAIL'}")
        print(f"coverage-missing\t{len(missing)}")
        print(f"coverage-duplicates\t{len(duplicate)}")
        print(f"coverage-extra\t{len(extra)}")
        print(f"coverage-duplicate-or-extra\t{len(duplicate) + len(extra)}")
        print(f"coverage-targets\t{len(expected_targets)}\t{len(observed_targets)}\t{'PASS' if expected_targets == observed_targets else 'FAIL'}")
        print(
            "coverage-report-json\t"
            + json.dumps(
                {
                    "expected_targets": sorted(expected_targets),
                    "observed_targets": sorted(observed_targets),
                    "missing": missing,
                    "duplicates": duplicate,
                    "extra": extra,
                    "inventory_status": inventory_status,
                },
                sort_keys=True,
            )
        )
    print(f"budget-seconds\t{arguments.budget_seconds:.3f}\t{'PASS' if budget_pass else 'FAIL'}")
    success = (
        status == 0
        and target_pass
        and tests_pass
        and archive_fixture_nested_cargo_pass
        and budget_pass
        and coverage_pass
    )
    print(f"result\t{'PASS' if success else 'FAIL'}")
    return 0 if success else status or 1
if __name__ == "__main__":
    raise SystemExit(main())
