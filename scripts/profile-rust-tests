#!/usr/bin/env python3
"""Run and enforce the exact complete Rust test workload once."""
from __future__ import annotations
import argparse
import json
import os
import re
import signal
import subprocess
import sys
import tempfile
import threading
import time
from collections import Counter
from pathlib import Path
from profile_rust_accounting import listed_test_inventory_from_completed_binaries, observed_test_inventory, observed_test_outcomes
from profile_rust_windows_launcher import launch_windows_workload
from profile_rust_workflow import enforce_workflow_contract
from profile_rust_windows_job import WindowsJob
BUDGET_SECONDS = 180.0
WINDOWS_BUDGET_SECONDS = 540.0
MINIMUM_PASSED_TESTS = 1802
REQUIRED_JOB_TIMEOUT_MINUTES = 4
WORKLOAD = ("cargo", "test", "--locked", "--all-targets")
COMPILE_PATTERN = re.compile(r"Finished `test` profile .* in (?:(\d+)m )?([0-9.]+)s")
RESULT_PATTERN = re.compile(r"test result: (?:ok|FAILED)\. (\d+) passed; (\d+) failed; (\d+) ignored; \d+ measured; \d+ filtered out")
def archive_fixture_nested_cargo_build_count(root: Path) -> int:
    helper = root / "tests/support/release_archive.rs"
    try:
        source = helper.read_text()
    except OSError as error:
        sys.stderr.write(f"archive fixture helper is unreadable: {error}\n")
        raise SystemExit(1) from None
    return source.count('Command::new("cargo")')
def replay_output(output: bytes) -> bool:
    binary = getattr(sys.stdout, "buffer", None)
    if binary is None:
        sys.stdout.write(output.decode("utf-8"))
        return False
    binary.write(output)
    return True
def flush_output() -> None:
    getattr(sys.stdout, "buffer", sys.stdout).flush()
def observe_first_line(capture_path: Path, process: subprocess.Popen[bytes], lines: list[bytes]) -> None:
    with capture_path.open("rb", buffering=0) as capture:
        while process.poll() is None:
            capture.seek(0)
            line = capture.readline()
            if line.endswith(b"\n"):
                lines.append(line)
                replay_output(line)
                flush_output()
                return
            time.sleep(0.01)
def run_workload(root: Path, budget_seconds: float) -> tuple[str, float, int, dict[str, float | str]]:
    started = time.perf_counter()
    deadline = time.monotonic() + budget_seconds
    phases: dict[str, float | str] = {"windows-job-active-zero": "not-applicable", **dict.fromkeys(("cargo-root-status", "windows-job-pids-json", "windows-job-images-json"), "not-applicable")}
    with tempfile.TemporaryDirectory(prefix="codexy-profile-") as directory:
        capture_path = Path(directory) / "cargo-output"
        capture_path.touch(mode=0o600)
        first_line: list[bytes] = []
        with capture_path.open("wb", buffering=0) as capture:
            job = WindowsJob() if os.name == "nt" else None
            process = (
                subprocess.Popen(WORKLOAD, cwd=root, stdout=capture, stderr=subprocess.STDOUT, start_new_session=os.name == "posix")
                if job is None else launch_windows_workload(job, root, capture, WORKLOAD)
            )
            observer = threading.Thread(
                target=observe_first_line,
                args=(capture_path, process, first_line),
                name="cargo-first-line",
                daemon=True,
            )
            observer.start()
            try:
                if job is None:
                    status = process.wait(timeout=budget_seconds)
                else:
                    try:
                        status = process.wait(timeout=max(0, deadline - time.monotonic()))
                    except subprocess.TimeoutExpired:
                        phases["windows-job-active-zero"] = "deadline"
                        phases.update(job.diagnostics(process))
                        job.terminate_and_wait()
                        status = 124
                    else:
                        phases.update(job.diagnostics(process))
                        if job.wait_for_empty_until(time.monotonic()):
                            phases["windows-job-active-zero"] = "completed"
                        else:
                            phases["windows-job-active-zero"] = "drained"
                            job.terminate_and_wait()
            except subprocess.TimeoutExpired:
                stop_workload(process, job)
                status = 124
            except KeyboardInterrupt:
                stop_workload(process, job)
                raise
            finally:
                capture_started = time.perf_counter()
                if job is not None:
                    job.close()
                observer.join()
                del process
        output = capture_path.read_bytes()
    phases["workload-seconds"] = capture_started - started
    phases["capture-seconds"] = time.perf_counter() - capture_started
    live_output = first_line[0] if first_line else b""
    tail = output[len(live_output) :]
    replay_started = time.perf_counter()
    if tail:
        replay_output(tail)
    flush_output()
    phases["replay-seconds"] = time.perf_counter() - replay_started
    output_text = output.decode("utf-8")
    elapsed = budget_seconds if status == 124 else time.perf_counter() - started
    return output_text, elapsed, status, phases
def terminate_workload(process: subprocess.Popen[str]) -> None:
    if process.poll() is not None:
        return
    os.killpg(process.pid, signal.SIGKILL)
    process.wait()
def stop_workload(process: subprocess.Popen[str], job: WindowsJob | None) -> None:
    job.terminate_and_wait() if job is not None else terminate_workload(process)
def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--root", type=Path, default=Path(__file__).resolve().parent.parent)
    parser.add_argument("--workflow-file", type=Path)
    parser.add_argument("--budget-seconds", type=float, default=BUDGET_SECONDS)
    parser.add_argument("--verify-coverage", action="store_true")
    parser.add_argument("--windows", action="store_true")
    arguments = parser.parse_args()
    root = arguments.root.resolve()
    if arguments.windows:
        arguments.verify_coverage = True
        arguments.budget_seconds = WINDOWS_BUDGET_SECONDS
    workflow = arguments.workflow_file or root / ".github/workflows/rust-test.yml"
    enforce_workflow_contract(workflow, REQUIRED_JOB_TIMEOUT_MINUTES, WORKLOAD)
    archive_fixture_nested_cargo_builds = archive_fixture_nested_cargo_build_count(root)
    started = time.perf_counter()
    output, elapsed, status, phases = run_workload(root, arguments.budget_seconds)
    expected_tests: Counter[str] = Counter()
    expected_targets: set[str] = set()
    inventory_status = 0
    inventory_seconds = 0.0
    if arguments.verify_coverage:
        inventory_started = time.perf_counter()
        (expected_tests, expected_targets), inventory_status = (
            listed_test_inventory_from_completed_binaries(root, output)
        )
        inventory_seconds = time.perf_counter() - inventory_started
    phases["inventory-seconds"] = inventory_seconds
    accounting_started = time.perf_counter()
    outcomes = observed_test_outcomes(output)
    if not outcomes and not arguments.verify_coverage:
        for passed, failed, ignored in RESULT_PATTERN.findall(output):
            outcomes.update({"ok": int(passed), "FAILED": int(failed), "ignored": int(ignored)})
    passed = outcomes["ok"]
    failed = outcomes["FAILED"]
    ignored = outcomes["ignored"]
    compile_matches = COMPILE_PATTERN.findall(output)
    compile_seconds = (
        int(compile_matches[-1][0] or 0) * 60 + float(compile_matches[-1][1])
        if compile_matches
        else 0.0
    )
    execution_seconds = max(0.0, elapsed - compile_seconds)
    target_pass = bool(expected_targets) if arguments.verify_coverage else True
    tests_pass = passed >= MINIMUM_PASSED_TESTS and failed == 0 and ignored == 0
    archive_fixture_nested_cargo_pass = archive_fixture_nested_cargo_builds == 0
    observed_tests, observed_targets = observed_test_inventory(output)
    missing = sorted((expected_tests - observed_tests).elements())
    unexpected = observed_tests - expected_tests
    duplicate = sorted(
        name
        for name, count in unexpected.items()
        if expected_tests[name] > 0
        for _ in range(count)
    )
    extra = sorted(
        name
        for name, count in unexpected.items()
        if expected_tests[name] == 0
        for _ in range(count)
    )
    coverage_pass = (
        not arguments.verify_coverage
        or (
            inventory_status == 0
            and expected_tests
            and not missing
            and not duplicate
            and not extra
            and expected_targets == observed_targets
        )
    )
    total_elapsed = time.perf_counter() - started
    phases["accounting-seconds"] = time.perf_counter() - accounting_started
    budget_pass = total_elapsed <= arguments.budget_seconds
    print(f"command\t{' '.join(WORKLOAD)}")
    print("workload-invocations\t1")
    if arguments.verify_coverage:
        print(f"compiled-targets\t{len(expected_targets)}\t{'PASS' if target_pass else 'FAIL'}")
    print(f"tests\t{passed} passed\t{failed} failed\t{ignored} ignored\t{'PASS' if tests_pass else 'FAIL'}")
    print(f"archive-fixture-nested-cargo-builds\t{archive_fixture_nested_cargo_builds}\t{'PASS' if archive_fixture_nested_cargo_pass else 'FAIL'}")
    for name, value in (("child-status", status), ("windows-job-active-zero", phases["windows-job-active-zero"]), ("cargo-root-status", phases["cargo-root-status"]), ("windows-job-pids-json", phases["windows-job-pids-json"]), ("windows-job-images-json", phases["windows-job-images-json"])):
        print(f"{name}\t{value}")
    for phase in ("workload", "capture", "replay", "inventory", "accounting"):
        print(f"phase-{phase}-seconds\t{phases[f'{phase}-seconds']:.3f}")
    print(f"compile-seconds\t{compile_seconds:.3f}")
    print(f"execution-seconds\t{execution_seconds:.3f}")
    if arguments.verify_coverage:
        print(f"inventory-seconds\t{inventory_seconds:.3f}")
    print(f"total-seconds\t{total_elapsed:.3f}")
    if arguments.verify_coverage:
        print(f"coverage-tests\t{sum(expected_tests.values())}\t{sum(observed_tests.values())}\t{'PASS' if coverage_pass else 'FAIL'}")
        print(f"coverage-missing\t{len(missing)}")
        print(f"coverage-duplicates\t{len(duplicate)}")
        print(f"coverage-extra\t{len(extra)}")
        print(f"coverage-duplicate-or-extra\t{len(duplicate) + len(extra)}")
        print(f"coverage-targets\t{len(expected_targets)}\t{len(observed_targets)}\t{'PASS' if expected_targets == observed_targets else 'FAIL'}")
        print(
            "coverage-report-json\t"
            + json.dumps(
                {
                    "expected_targets": sorted(expected_targets),
                    "observed_targets": sorted(observed_targets),
                    "missing": missing,
                    "duplicates": duplicate,
                    "extra": extra,
                    "inventory_status": inventory_status,
                },
                sort_keys=True,
            )
        )
    print(f"budget-seconds\t{arguments.budget_seconds:.3f}\t{'PASS' if budget_pass else 'FAIL'}")
    success = (
        status == 0
        and target_pass
        and tests_pass
        and archive_fixture_nested_cargo_pass
        and budget_pass
        and coverage_pass
    )
    print(f"result\t{'PASS' if success else 'FAIL'}")
    return 0 if success else status or 1
if __name__ == "__main__":
    raise SystemExit(main())
