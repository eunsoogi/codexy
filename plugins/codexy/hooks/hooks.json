        "hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/hooks/codexy-repository-pull-request.sh\" PreToolUse", "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-repository-pull-request.cmd\" PreToolUse", "timeout": 5}]
      },
      {
        "matcher": "^mcp__codex_apps__github_(merge_pull_request|enable_auto_merge)$",
        "hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/hooks/codexy-repository-merge.sh\" PreToolUse", "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-repository-merge.cmd\" PreToolUse", "timeout": 5}]
      },
      {
        "matcher": "^Bash$",
        "hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/hooks/codexy-repository-github-command.sh\" PreToolUse", "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-repository-github-command.cmd\" PreToolUse", "timeout": 5}]
      },
      {
        "matcher": "^Bash$",
        "hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/hooks/codexy-destructive-command.sh\" PreToolUse", "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-destructive-command.cmd\" PreToolUse", "timeout": 5}]
      }
