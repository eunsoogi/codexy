{
  "hooks": {
    "PermissionRequest": [
      {
        "matcher": "^(?:codex_app__|mcp__codex_app__)send_message_to_thread$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/codexy-thread-delivery.sh\" PermissionRequest",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-thread-delivery.cmd\" PermissionRequest",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(?:codex_app__|mcp__codex_app__)create_thread$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/codexy-child-thread-creation.sh\" PermissionRequest",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-child-thread-creation.cmd\" PermissionRequest",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(?:(?:agents|multi_agent_v1)__)?(?:spawn_agent|send_message|followup_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/codexy-subagent-ownership.sh\" PermissionRequest",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-subagent-ownership.cmd\" PermissionRequest",
            "timeout": 5
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^(?:codex_app__|mcp__codex_app__)(?:set_thread_archived|list_archived_threads)$",
        "hooks": [{
          "type": "command",
          "command": "\"${PLUGIN_ROOT}/hooks/codexy-cleanup-progress.sh\" PostToolUse",
          "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-cleanup-progress.cmd\" PostToolUse",
          "timeout": 5
        }]
      }
    ],
    "Stop": [{
      "hooks": [{
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/hooks/codexy-cleanup-progress.sh\" Stop",
        "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-cleanup-progress.cmd\" Stop",
        "timeout": 5
      }]
    }],
    "Interrupt": [{
      "hooks": [{
        "type": "command",
        "command": "\"${PLUGIN_ROOT}/hooks/codexy-cleanup-progress.sh\" Interrupt",
        "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-cleanup-progress.cmd\" Interrupt",
        "timeout": 1
      }]
    }],
    "PreToolUse": [
      {
        "matcher": "^(?:codex_app__|mcp__codex_app__)send_message_to_thread$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/codexy-thread-delivery.sh\" PreToolUse",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-thread-delivery.cmd\" PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(?:codex_app__|mcp__codex_app__)create_thread$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/codexy-child-thread-creation.sh\" PreToolUse",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-child-thread-creation.cmd\" PreToolUse",
            "timeout": 5
          }
        ]
      },
      {
        "matcher": "^(?:(?:agents|multi_agent_v1)__)?(?:spawn_agent|send_message|followup_task)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/codexy-subagent-ownership.sh\" PreToolUse",
            "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-subagent-ownership.cmd\" PreToolUse",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
