        "hooks": [{"type": "command", "command": "\"${PLUGIN_ROOT}/hooks/codexy-repository-issue.sh\" PreToolUse", "commandWindows": "\"${PLUGIN_ROOT}/hooks/codexy-repository-issue.cmd\" PreToolUse", "timeout": 5}]
