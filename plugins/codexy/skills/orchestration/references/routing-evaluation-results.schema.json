{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "corpus_id", "selected_effort", "results"],
  "properties": {
    "schema": { "const": "codexy.routing-evaluation-results.v1" },
    "corpus_id": { "type": "string" },
    "selected_effort": { "enum": ["high", "xhigh", "max"] },
    "results": {
      "type": "array",
      "minItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "task_id",
          "prompt",
          "acceptance_oracle",
          "model",
          "thinking",
          "acceptance",
          "p0_p1_misses",
          "proof_complete",
          "repairs_retries",
          "tokens",
          "wall_time_ms",
          "observed_cost_usd"
        ],
        "properties": {
          "task_id": { "type": "string" },
          "prompt": { "type": "string" },
          "acceptance_oracle": { "type": "string" },
          "model": { "const": "gpt-5.6-terra" },
          "thinking": { "enum": ["high", "xhigh", "max"] },
          "acceptance": { "enum": ["pass", "fail"] },
          "p0_p1_misses": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "proof_complete": { "type": "boolean" },
          "repairs_retries": {
            "type": "integer",
            "minimum": 0,
            "maximum": 4294967295
          },
          "tokens": { "type": ["integer", "null"], "minimum": 0 },
          "wall_time_ms": { "type": ["integer", "null"], "minimum": 0 },
          "observed_cost_usd": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    }
  }
}
