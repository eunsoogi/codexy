{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "corpusId", "candidate", "thresholds", "measureAvailability", "comparisons", "decisionInputs"],
  "properties": {
    "schema": { "const": "codexy.efficiency-scorecard.v1" },
    "corpusId": { "const": "orchestration-1.5-baseline-v1" },
    "candidate": { "$ref": "#/$defs/candidate" },
    "thresholds": { "$ref": "#/$defs/thresholds" },
    "measureAvailability": { "$ref": "#/$defs/availability" },
    "comparisons": { "type": "array", "minItems": 5, "items": { "$ref": "#/$defs/comparison" } },
    "decisionInputs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/decision" } }
  },
  "$defs": {
    "safeId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "candidate": {
      "type": "object", "additionalProperties": false,
      "required": ["head", "installedContentSha256"],
      "properties": {
        "head": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "installedContentSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" }
      }
    },
    "thresholds": {
      "type": "object", "additionalProperties": false,
      "required": ["medianInputTokenReductionMinPct", "p95ToolOutputByteReductionMinPct", "maxP0P1Misses", "acceptanceMinPct", "maxRepairCycleIncrease", "maxReviewCycleIncrease"],
      "properties": {
        "medianInputTokenReductionMinPct": { "type": "number", "minimum": 25 },
        "p95ToolOutputByteReductionMinPct": { "type": "number", "minimum": 40 },
        "maxP0P1Misses": { "const": 0 },
        "acceptanceMinPct": { "type": "number", "minimum": 95 },
        "maxRepairCycleIncrease": { "type": "integer", "maximum": 0 },
        "maxReviewCycleIncrease": { "type": "integer", "maximum": 0 }
      }
    },
    "availability": {
      "type": "object", "additionalProperties": false,
      "required": ["inputTokens", "wallTimeMs", "observedCostUsd", "toolInputBytes", "toolOutputBytes", "cacheInputTokens"],
      "properties": {
        "inputTokens": { "$ref": "#/$defs/availabilityState" },
        "wallTimeMs": { "$ref": "#/$defs/availabilityState" },
        "observedCostUsd": { "$ref": "#/$defs/availabilityState" },
        "toolInputBytes": { "$ref": "#/$defs/availabilityState" },
        "toolOutputBytes": { "$ref": "#/$defs/availabilityState" },
        "cacheInputTokens": { "$ref": "#/$defs/availabilityState" }
      }
    },
    "availabilityState": { "enum": ["available", "unavailable"] },
    "owner": {
      "type": "object", "additionalProperties": false, "required": ["kind", "id"],
      "properties": { "kind": { "enum": ["root", "child", "selected-reviewer"] }, "id": { "$ref": "#/$defs/safeId" } }
    },
    "window": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "required": ["kind", "beforeRecords", "afterRecords"], "properties": { "kind": { "const": "equal-record-count" }, "beforeRecords": { "type": "integer", "minimum": 1 }, "afterRecords": { "type": "integer", "minimum": 1 } } },
        { "type": "object", "additionalProperties": false, "required": ["kind", "beforeDurationSeconds", "afterDurationSeconds"], "properties": { "kind": { "const": "equal-duration" }, "beforeDurationSeconds": { "type": "integer", "minimum": 1 }, "afterDurationSeconds": { "type": "integer", "minimum": 1 } } }
      ]
    },
    "measurements": {
      "type": "object", "additionalProperties": false,
      "required": ["acceptanceRuns", "acceptedRuns", "p0P1Misses", "proofCompleteRuns", "repairs", "reviewCycles", "inputTokens", "wallTimeMs", "observedCostUsd", "toolInputBytes", "toolOutputBytes", "cacheInputTokens"],
      "properties": {
        "acceptanceRuns": { "type": "integer", "minimum": 0 }, "acceptedRuns": { "type": "integer", "minimum": 0 },
        "p0P1Misses": { "type": "integer", "minimum": 0 }, "proofCompleteRuns": { "type": "integer", "minimum": 0 },
        "repairs": { "type": "integer", "minimum": 0 }, "reviewCycles": { "type": "integer", "minimum": 0 },
        "inputTokens": { "type": ["integer", "null"], "minimum": 0 }, "wallTimeMs": { "type": ["integer", "null"], "minimum": 0 },
        "observedCostUsd": { "type": ["number", "null"], "minimum": 0 }, "toolInputBytes": { "type": ["integer", "null"], "minimum": 0 },
        "toolOutputBytes": { "type": ["integer", "null"], "minimum": 0 }, "cacheInputTokens": { "type": ["integer", "null"], "minimum": 0 }
      }
    },
    "comparison": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "optimizationId", "optimizationSet", "model", "effort", "taskId", "taskClass", "owner", "phase", "window", "before", "after"],
      "properties": {
        "id": { "$ref": "#/$defs/safeId" }, "optimizationId": { "$ref": "#/$defs/safeId" }, "taskId": { "$ref": "#/$defs/safeId" },
        "optimizationSet": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "#/$defs/safeId" } },
        "model": { "$ref": "#/$defs/safeId" }, "effort": { "enum": ["low", "medium", "high", "xhigh", "max", "ultra"] },
        "taskClass": { "enum": ["simple-discovery", "general-implementation", "review-response", "strict-work", "compaction-recovery"] },
        "owner": { "$ref": "#/$defs/owner" }, "phase": { "enum": ["discovery", "implementation", "review-response", "strict-work", "compaction-recovery", "wait", "tool-output"] },
        "window": { "$ref": "#/$defs/window" }, "before": { "$ref": "#/$defs/measurements" }, "after": { "$ref": "#/$defs/measurements" }
      }
    },
    "decision": {
      "type": "object", "additionalProperties": false, "required": ["optimizationId", "comparisonIds", "evidenceState", "unavailableMeasures"],
      "properties": {
        "optimizationId": { "$ref": "#/$defs/safeId" }, "comparisonIds": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/safeId" } },
        "evidenceState": { "enum": ["observable", "unobservable"] }, "unavailableMeasures": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
