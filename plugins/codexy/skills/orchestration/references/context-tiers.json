    { "name": "external_gate", "tier": "always_on", "identity": "volatile", "authority": "token_efficient", "safety_invariant": true, "budget_exempt": true },
    { "name": "next_action", "tier": "always_on", "identity": "volatile", "authority": "token_efficient", "safety_invariant": true, "budget_exempt": true },
    { "name": "selected_references", "tier": "task_selected", "identity": "stable", "authority": "task_classification", "safety_invariant": false, "budget_exempt": false },
    { "name": "qualifying_event_delta", "tier": "event_delta", "identity": "volatile", "authority": "token_efficient", "safety_invariant": false, "budget_exempt": false },
    { "name": "authoritative_refresh_handles", "tier": "refresh_only", "identity": "volatile", "authority": "proof_completion", "safety_invariant": false, "budget_exempt": false }
  ],
  "profile_matrix": {
    "light": {
      "always_on": "required",
      "task_selected": "when_applicable",
      "event_delta": "typed_omission_when_not_applicable",
      "refresh_only": "typed_omission_when_not_applicable"
    },
    "standard": {
      "always_on": "required",
      "task_selected": "required",
      "event_delta": "when_applicable",
      "refresh_only": "required_before_authoritative_action"
    },
    "strict": {
      "always_on": "required",
      "task_selected": "required",
      "event_delta": "when_applicable",
      "refresh_only": "required_before_authoritative_action"
    }
  },
  "omission_reasons": ["not_applicable", "not_created", "external_surface_absent"],
  "routing": {
    "task_classes": ["read_only", "documentation", "implementation", "review_response", "validation_qa", "orchestration_recovery"],
    "task_reference_routes": {
      "read_only": ["task_classification"],
      "documentation": ["task_classification", "proof_completion"],
      "implementation": ["task_classification", "execution_budget", "proof_completion"],
      "review_response": ["task_classification", "review_profiles", "review_lifecycle", "proof_completion"],
      "validation_qa": ["task_classification", "review_profiles", "proof_completion"],
      "orchestration_recovery": ["task_classification", "token_efficient", "dreaming", "proof_completion"]
    },
    "fail_closed_classes": ["unknown", "ambiguous", "high_risk", "security", "permission", "release"],
    "fallback_authority": "child_routing",
    "fail_closed_preserves_all_safety_fields": true
  },
  "ordering": {
    "stable_prefix": "codexy.context.stable.v1",
    "volatile_prefix": "codexy.context.volatile.v1",
    "stable_identity": "sha256_exact_contract_bytes_and_typed_stable_fields",
    "volatile_identity": "sha256_typed_envelope_in_field_order",
    "stable_fields": ["workflow_profile", "task_classification", "selected_references"],
    "volatile_fields": ["issue_pr_identity", "owner_worktree", "base_head_sha", "dirty_index_state", "checks", "unresolved_review_threads", "selected_reviewer_state", "verification", "external_gate", "next_action", "qualifying_event_delta", "authoritative_refresh_handles"]
  },
  "budget_semantics": {
    "context_unit": "utf8_bytes_after_serialization",
    "output_unit": "utf8_bytes_emitted",
    "limit_source": "positive_consumer_supplied_per_stage",
    "stages": ["classification", "implementation", "repair", "review", "handoff"],
    "context_floor": ["always_on", "applicable_task_selected"],
    "refresh_only": "payload_bytes_excluded_from_retained_context",
    "overflow_order": ["deduplicate_unchanged_event_delta", "drop_unselected_references", "fail_closed"],
    "required_output": ["required_proof_state", "one_next_action"],
    "cache_metadata": "unavailable_not_zero",
    "cache_savings_claims": "prohibited_without_runtime_evidence"
  },
  "forbidden_context": ["full_conversation_forwarding", "full_tool_body_forwarding", "full_agent_tree_forwarding"]
}
