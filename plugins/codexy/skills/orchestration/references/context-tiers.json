  ],
  "retained_fields": [
    { "name": "workflow_profile", "tier": "always_on", "identity": "stable", "authority": "workflow_profiles", "safety_invariant": false, "budget_exempt": true },
    { "name": "task_classification", "tier": "always_on", "identity": "stable", "authority": "task_classification", "safety_invariant": false, "budget_exempt": true },
    { "name": "issue_pr_identity", "tier": "always_on", "identity": "volatile", "authority": "token_efficient", "safety_invariant": true, "budget_exempt": true },
    { "name": "owner_worktree", "tier": "always_on", "identity": "volatile", "authority": "token_efficient", "safety_invariant": true, "budget_exempt": true },
    { "name": "base_head_sha", "tier": "always_on", "identity": "volatile", "authority": "token_efficient", "safety_invariant": true, "budget_exempt": true },
    { "name": "dirty_index_state", "tier": "always_on", "identity": "volatile", "authority": "token_efficient", "safety_invariant": true, "budget_exempt": true },
    { "name": "checks", "tier": "always_on", "identity": "volatile", "authority": "token_efficient", "safety_invariant": true, "budget_exempt": true },
    { "name": "unresolved_review_threads", "tier": "always_on", "identity": "volatile", "authority": "token_efficient", "safety_invariant": true, "budget_exempt": true },
    { "name": "selected_reviewer_state", "tier": "always_on", "identity": "volatile", "authority": "review_profiles", "safety_invariant": true, "budget_exempt": true },
