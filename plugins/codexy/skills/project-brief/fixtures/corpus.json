{
  "schema": "codexy.project-brief-corpus.v1",
  "fields": [
    "objective",
    "owner",
    "verified_phase",
    "changes_since_touch",
    "decision_required",
    "evidence_handle",
    "next_action",
    "done_when"
  ],
  "base_recorded_state": {
    "objective": "resume the ongoing task",
    "owner": "task-current",
    "verified_phase": "local proof passed",
    "changes_since_touch": ["proof completed"],
    "decision_required": "unavailable",
    "evidence_handle": ["current task receipt"],
    "next_action": "request review",
    "done_when": "public verification passes"
  },
  "cases": [
    {
      "id": "PB-P01",
      "scenario": "return after inactivity with all eight recorded fields",
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P02",
      "scenario": "branch head changed since last touch",
      "recorded_patch": {
        "changes_since_touch": ["current head is def456"],
        "evidence_handle": ["branch def456"]
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P03",
      "scenario": "recorded owner changed",
      "recorded_patch": {
        "owner": "task-new",
        "changes_since_touch": ["owner changed to task-new"]
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P04",
      "scenario": "proof completed after last touch",
      "recorded_patch": {
        "verified_phase": "package proof completed",
        "changes_since_touch": ["package proof passed"]
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P05",
      "scenario": "explicit decision is pending",
      "recorded_patch": {
        "decision_required": "choose blue or green"
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P06",
      "scenario": "next_action absent",
      "missing_fields": ["next_action"],
      "expected_patch": {
        "next_action": "unavailable"
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P07",
      "scenario": "done_when absent",
      "missing_fields": ["done_when"],
      "expected_patch": {
        "done_when": "unavailable"
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P08",
      "scenario": "merge complete, publication pending",
      "recorded_patch": {
        "verified_phase": "merge complete; publication pending",
        "changes_since_touch": ["PR merged"],
        "next_action": "publish artifact"
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P09",
      "scenario": "publication complete, public verification pending",
      "recorded_patch": {
        "verified_phase": "publication complete; public verification pending",
        "changes_since_touch": ["artifact published"],
        "next_action": "run public verification"
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
      "id": "PB-P10",
      "scenario": "stale memory conflicts with current PR",
      "recorded_patch": {
        "owner": "task-91",
        "verified_phase": "current PR checks passed",
        "changes_since_touch": ["current PR head is fed987"],
        "evidence_handle": ["PR #91 at fed987"],
        "next_action": "await review"
      },
      "stale_memory": {
        "owner": "task-old",
        "verified_phase": "checks failing",
        "next_action": "repair tests"
      },
      "expected_outcome": "EXACT_EIGHT_FIELD_PROJECTION"
    },
    {
